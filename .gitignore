deployment/*
!deployment/.gitkeep

# ── Cobertura de Tests ────────────────────────────────────────
coverage/
.nyc_output/

# ── PM2 ──────────────────────────────────────────────────────
.pm2/

# ── Docker (volúmenes locales) ────────────────────────────────
docker-composes/volumes/

# ── IDE y Editores ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

