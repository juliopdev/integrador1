# ── Dependencias ─────────────────────────────────────────────
node_modules/

# Gestores de paquetes: solo versionar pnpm-lock.yaml (el proyecto usa pnpm)
package-lock.json
yarn.lock
# pnpm-lock.yaml → NO ignorar, se versiona para reproducibilidad

# ── Variables de Entorno ──────────────────────────────────────
.env
.env.*.local
.env.local
# .env.example → NO ignorar, debe estar versionado como referencia

# ── Datos Locales (SQLite, backups) ───────────────────────────
data/
data/*
local_storage/
backups/*.db

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pino-*.log

# ── Compilados y Build ────────────────────────────────────────
dist/
public/styles/*.css
public/styles/*.css.map

# ── Despliegues de Tenants ────────────────────────────────────
