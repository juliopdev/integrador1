<%
  // Stepper reutilizable (Iter 34): lista ordenada de pasos con estado por item. Nace del
  // `_wizard-progress-panel` del asistente No-Code pero queda genérico para cualquier flujo
  // multi-paso (Fase 5 tenant-chat wizards, futuros wizards, etc.).
  //
  // API:
  //   items:      [{ id, label, state: 'done'|'current'|'pending', href? }]
  //   progress:   { current: number, total: number } | null (opcional — barra + contador)
  //   ariaLabel:  string (default: "Progreso")
  //
  // El componente decide la iconografía + BEM; la sección que lo consume decide qué es "done".
  const items = locals.items || [];
  const progress = locals.progress || null;
  const ariaLabel = locals.ariaLabel || 'Progreso';

  // Iter UX C1: cálculo del tramo pintado en la línea conectora. Cuenta los pasos `done` sobre
  // los N-1 tramos entre markers. Si el operador está en el paso 4 de 7 con los 3 anteriores
  // hechos, `donePct` = 3/6 = 50% → media línea azul, media gris. La transición se anima por
  // CSS al cambiar el ::before del __list.
  const doneCount = items.filter((it) => it.state === 'done').length;
  const totalGaps = Math.max(items.length - 1, 1);
  const donePct = Math.min(100, Math.round((doneCount / totalGaps) * 100));
%>
<nav class="c-stepper" aria-label="<%= ariaLabel %>" style="--c-stepper-done-pct: <%= donePct %>%;">
  <% if (progress) { %>
    <div class="c-stepper__header">
      <span class="c-stepper__title">Progreso</span>
      <span class="c-stepper__counter"><strong><%= progress.current %></strong>/<%= progress.total %></span>
    </div>
    <div class="c-stepper__bar" role="presentation">
      <div class="c-stepper__bar-fill" style="--c-stepper-progress: <%= Math.round((progress.current / Math.max(progress.total, 1)) * 100) %>%;"></div>
    </div>
  <% } %>
  <ol class="c-stepper__list">
    <% items.forEach((it, idx) => {
      const st = it.state || 'pending';
      const isCurrent = st === 'current';
      const stateLabel = isCurrent ? 'actual' : (st === 'done' ? 'hecho' : 'pendiente');
    %>
      <li class="c-stepper__item c-stepper__item--<%= st %>">
        <%# Con `href` el item navega; sin él es solo indicador de estado (wizards con
            navegación restringida a los botones del wizard-nav — PLAN-ux2 P1.3). %>
        <% if (it.href) { %>
        <a
          class="c-stepper__link"
          href="<%= it.href %>"
          aria-current="<%= isCurrent ? 'step' : 'false' %>"
          title="<%= stateLabel %>"
        >
          <span class="c-stepper__icon" aria-hidden="true"></span>
          <span class="c-stepper__body">
            <span class="c-stepper__index">Paso <%= idx + 1 %></span>
            <strong class="c-stepper__label"><%= it.label %></strong>
          </span>
        </a>
        <% } else { %>
        <span
          class="c-stepper__link c-stepper__link--static"
          aria-current="<%= isCurrent ? 'step' : 'false' %>"
          title="<%= stateLabel %>"
        >
          <span class="c-stepper__icon" aria-hidden="true"></span>
          <span class="c-stepper__body">
            <span class="c-stepper__index">Paso <%= idx + 1 %></span>
            <strong class="c-stepper__label"><%= it.label %></strong>
          </span>
        </span>
        <% } %>
      </li>
    <% }); %>
  </ol>
</nav>
