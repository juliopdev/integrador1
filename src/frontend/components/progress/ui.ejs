<%
  const value = Math.min(100, Math.max(0, locals.value || 0));
  const variant = locals.variant || 'default'; // default | usage
  const label = locals.label || '';
  const max = locals.max || '';
  const current = locals.current || '';
%>
<div class="c-progress <%= variant === 'usage' ? 'c-progress--usage' : '' %>" data-percentage="<%= value %>">
  <% if (variant === 'usage') { %>
    <div class="c-progress__header">
      <% if (label) { %>
        <span class="c-progress__label"><%= label %></span>
      <% } %>
      <span class="c-progress__stats">
        <% if (current && max) { %>
          <span class="c-progress__numbers"><%= current %> / <%= max %></span>
        <% } %>
        <span class="c-progress__percent"><%= value %>%</span>
      </span>
    </div>
  <% } %>
  <div class="c-progress__track" role="progressbar" aria-valuenow="<%= value %>" aria-valuemin="0" aria-valuemax="100">
    <div class="c-progress__fill" style="width: <%= value %>%;"></div>
  </div>
</div>
