<%
  // Sección reutilizable (views.md): listado de backends por tenant (P5).
  // Columnas: Tenant (projectName + subdominio) · Versión actual · Borrador · Keys · Acciones.
  // El "estado del tenant" se quitó: duplicaba el listado de Tenants (P5).
  const list = locals.tenants || [];
  const hostSuffix = locals.tenantHostSuffix || 'localhost';
  // `escHtml`, `fmtDate` y `tenantCell` vienen del defaultContext (common/views/helpers.js).

  const tableHtml = include('frontend/components/data-table/ui', {
    columns: [
      { key: 'tenant', label: 'Tenant' },
      { key: 'version', label: 'Versión actual' },
      { key: 'draft', label: 'Borrador' },
      { key: 'keys', label: 'Keys' },
      { key: 'actions', label: 'Acciones', align: 'right' },
    ],
    rows: list.map((t) => {
      const bs = t.backendStatus || {};
      const key = t.apiKeyStatus || { exists: false };
      const projectName = t.projectName || t.subdomain;

      // Iter UX: acciones agrupadas en la columna "Acciones". La columna "Keys" queda como estado
      // puro (fecha o vacío); las mutaciones (regenerar/generar) viven junto a Componer/Ver.
      const keyAction = key.exists
        ? include('frontend/components/button/ui', {
            label: 'Regenerar key',
            icon: 'cog',
            variant: 'ghost',
            size: 'sm',
            action: 'apikey:regenerate',
            target: t.id,
          })
        : include('frontend/components/button/ui', {
            label: 'Generar key',
            icon: 'plus',
            variant: 'ghost',
            size: 'sm',
            action: 'apikey:generate',
            target: t.id,
          });

      return {
        tenant: tenantCell({ projectName, subdomain: t.subdomain, hostSuffix }),
        version: bs.published
          ? include('frontend/components/badge/ui', { variant: 'success', label: `${bs.published.version} publicado` })
          : '<span class="u-text-muted">—</span>',
        draft: bs.draft
          ? include('frontend/components/badge/ui', { variant: 'warning', label: `${bs.draft.version} en curso` })
          : '<span class="u-text-muted">—</span>',
        keys: key.exists
          ? `<span class="u-text-xs u-text-muted">Activa desde ${fmtDate(key.createdAt)}</span>`
          : '<span class="u-text-muted">—</span>',
        actions: `
          <span class="nocode-key-cell nocode-key-cell--end">
            ${include('frontend/components/button/ui', {
              label: 'Componer',
              icon: 'cog',
              href: `/dashboard/backends/${t.id}`,
              variant: 'ghost',
              size: 'sm',
            })}
            ${bs.published ? include('frontend/components/button/ui', {
              label: 'Ver',
              icon: 'eye',
              href: `/dashboard/backends/${t.id}/versions/${bs.published.version}`,
              variant: 'ghost',
              size: 'sm',
            }) : ''}
            ${keyAction}
          </span>
        `,
      };
    }),
    emptyState: {
      title: 'Aún no hay tenants aprovisionados',
      message: 'Aprovisiona un tenant para poder componer su backend No-Code.',
      cta: {
        label: 'Aprovisionar tenant',
        icon: 'plus',
        href: '/dashboard/tenants/create',
      },
    },
  });

  const searchHtml = include('frontend/components/search-input/ui', {
    name: 'query',
    placeholder: 'Buscar backends...',
    id: 'table-search-input',
  });

  const paginationHtml = include('frontend/components/pagination/ui', {
    currentPage: 1,
    totalPages: 1,
  });

  const toolbarHtml = `
    <div class="l-table-toolbar u-mb-md" style="max-width: 25rem;">
      ${searchHtml}
    </div>
  `;
%>

<%- include('frontend/components/card/ui', {
  body: `
    ${toolbarHtml}
    ${tableHtml}
    <div class="u-mt-md" id="table-pagination-container">
      ${paginationHtml}
    </div>
  `,
  padding: 'md'
}) %>

<% if (list.length > 0) { %>
  <script>
    (() => {
      const initTableFilter = () => {
        const container = document.getElementById('table-pagination-container');
        const parent = container ? container.closest('.c-card') : document;
        const searchInput = parent.querySelector('.c-search-input__field');
        const clearBtn = parent.querySelector('.c-search-input__clear');
        const tableRows = Array.from(parent.querySelectorAll('.c-data-table__body .c-data-table__row'));
        const prevBtn = container ? container.querySelector('.c-pagination__btn:first-of-type') : null;
        const nextBtn = container ? container.querySelector('.c-pagination__btn:last-of-type') : null;
        const currentLabel = container ? container.querySelector('.c-pagination__current') : null;
        const totalLabel = container ? container.querySelector('.c-pagination__total') : null;

        if (tableRows.length === 0) {
          if (container) container.style.display = 'none';
          return;
        }

        let filteredRows = [...tableRows];
        let currentPage = 1;
        const itemsPerPage = 5;

        function updateTable() {
          const totalPages = Math.max(1, Math.ceil(filteredRows.length / itemsPerPage));
          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          tableRows.forEach(row => row.style.display = 'none');

          const start = (currentPage - 1) * itemsPerPage;
          const end = start + itemsPerPage;
          const pageRows = filteredRows.slice(start, end);
          pageRows.forEach(row => row.style.display = '');

          if (currentLabel) currentLabel.textContent = currentPage;
          if (totalLabel) totalLabel.textContent = totalPages;

          if (prevBtn) {
            if (currentPage === 1) {
              prevBtn.setAttribute('disabled', 'true');
            } else {
              prevBtn.removeAttribute('disabled');
            }
          }
          if (nextBtn) {
            if (currentPage === totalPages) {
              nextBtn.setAttribute('disabled', 'true');
            } else {
              nextBtn.removeAttribute('disabled');
            }
          }

          if (container) {
            container.style.display = filteredRows.length <= itemsPerPage ? 'none' : '';
          }
        }

        function filterTable() {
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          filteredRows = tableRows.filter(row => {
            if (query === '') return true;
            const cells = Array.from(row.querySelectorAll('.c-data-table__cell'));
            for (let i = 0; i < cells.length - 1; i++) {
              if (cells[i].textContent.toLowerCase().includes(query)) {
                return true;
              }
            }
            return false;
          });

          currentPage = 1;
          updateTable();
        }

        if (searchInput) {
          searchInput.addEventListener('input', filterTable);
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            setTimeout(() => {
              filterTable();
            }, 0);
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              updateTable();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            if (currentPage < totalPages) {
              currentPage++;
              updateTable();
            }
          });
        }

        updateTable();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTableFilter);
      } else {
        initTableFilter();
      }
    })();
  </script>
<% } %>

<%# P5: modal de revelado de la key — el valor crudo existe SOLO acá (en DB queda el hash).
    Lo puebla el bus handler `apikey:*` de dashboard.entry.js antes de abrirlo. %>
<%- include('frontend/components/modal/ui', {
  id: 'apikey-reveal',
  title: 'API key del tenant',
  body: `
    <p class="u-text-sm u-mb-sm">
      Copia esta key en el frontend del tenant (header <code>Authorization: Bearer …</code>).
      <strong>No volverá a mostrarse</strong>: se guarda hasheada — si se pierde, regenérala.
    </p>
    <code class="nocode-key-reveal" data-apikey-slot>…</code>
  `,
  footer: `
    ${include('frontend/components/button/ui', {
      label: 'Copiar',
      variant: 'primary',
      size: 'sm',
      action: 'apikey:copy',
    })}
  `,
}) %>
