<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <h1 class="auth-card__title">Frase de Seguridad</h1>
      <p class="auth-card__subtitle">Define tu frase de seguridad adicional de administrador</p>
    </div>
    <form class="auth-card__form" action="/dashboard/add-passphrase" method="POST">
      <div class="auth-card__group">
        <label class="auth-card__label" for="passphrase">Frase de Seguridad (Passphrase)</label>
        <input class="auth-card__input" type="password" id="passphrase" name="passphrase" required placeholder="••••••••" />
      </div>
      <button type="submit" class="auth-card__button">Registrar Frase</button>
    </form>
  </div>
</div>
