<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <h1 class="auth-card__title">Recuperar Acceso</h1>
      <p class="auth-card__subtitle">Ingresa tu correo para restaurar tu contraseña</p>
    </div>
    <form class="auth-card__form" action="/dashboard/forgot-password" method="POST">
      <div class="auth-card__group">
        <label class="auth-card__label" for="email">Correo Electrónico</label>
        <input class="auth-card__input" type="email" id="email" name="email" required placeholder="correo@ejemplo.com" />
      </div>
      <button type="submit" class="auth-card__button">Enviar Enlace</button>
    </form>
    <div style="margin-top: 1.5rem; text-align: center;">
      <a href="/dashboard/login" style="color: var(--accent-color); text-decoration: none; font-size: 0.9rem;">&larr; Volver al Login</a>
    </div>
  </div>
</div>
