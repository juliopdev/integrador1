{
  "name": "baas-platform",
  "version": "1.0.0",
  "description": "Multi-Tenant Backend-as-a-Service Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src/backend --watch server.js --ignore 'data/*' --ignore 'public/*' --ignore '_tmp_*' server.js",
    "start": "node server.js",
    "worker": "node worker.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate:platform": "drizzle-kit generate --config=drizzle.platform.config.js",
    "db:generate:tenant": "drizzle-kit generate --config=drizzle.tenant.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/passport": "^3.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/view": "^10.0.2",
    "@fastify/websocket": "^11.0.1",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mitt": "^3.0.1",
    "mongodb": "^6.21.0",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "resend": "^6.16.0",
    "stripe": "^22.3.2",
    "swup": "^4.9.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "form-data": "^4.0.6",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "sass": "^1.83.4",
    "vite": "^8.0.16",
    "vitest": "^3.0.5",
    "ws": "^8.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.0",
      "onFail": "download"
    }
  }
}
